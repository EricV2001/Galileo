# ──────────────────────────────────────────────
# Galileo Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── Claude Authentication (pick one) ─────────
# Option 1: Claude subscription (Pro/Max) — run `claude setup-token` to get this
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Option 2: Pay-per-use API key
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Assistant ─────────────────────────────────
# ASSISTANT_NAME=Andy

# ── Container ─────────────────────────────────
# CONTAINER_IMAGE=nanoclaw-agent:latest
# CONTAINER_TIMEOUT=1800000
# IDLE_TIMEOUT=1800000
# MAX_CONCURRENT_CONTAINERS=5

# ── Galileo: Routing ─────────────────────────
# LOCAL_FIRST  — try local model, fall back to Claude on error
# LOCAL_ONLY   — local model only, fail if unavailable
# CLAUDE_ONLY  — always use Anthropic API (default)
GALILEO_ROUTING_MODE=CLAUDE_ONLY

# ── Galileo: LM Studio ──────────────────────
# OpenAI-compatible endpoint (LMLink makes Mac Studio models appear as localhost)
GALILEO_LMSTUDIO_URL=http://localhost:1234/v1
GALILEO_MODEL_GENERAL=qwen3.5-27b
GALILEO_MODEL_EXTRACTION=qwen3.5-9b
GALILEO_MODEL_EMBEDDING=nomic-embed-text-v1.5

# ── Galileo: Knowledge Graph (Neo4j) ────────
GALILEO_MEMORY_ENABLED=false
GALILEO_NEO4J_URI=bolt://localhost:7687
GALILEO_NEO4J_USER=neo4j
GALILEO_NEO4J_PASSWORD=
GALILEO_MAX_RECALL_RESULTS=5
GALILEO_DECAY_HALF_LIFE_DAYS=30

# ── Galileo: Obsidian Integration ────────────
# Path to your Obsidian vault (leave empty to skip)
GALILEO_OBSIDIAN_VAULT_PATH=
